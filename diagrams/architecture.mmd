flowchart TD
    U["User request (free text)<br/>demo.py CLI or Streamlit AI Planner tab"] --> IG

    subgraph GR1["pawpal_ai/guardrails.py: check_input (input guardrail)"]
        IG{"empty / too long / emergency /<br/>prompt injection / medical-dosage /<br/>budget under 10 min"}
    end
    IG -- "blocked" --> REF["Refusal message (vet or emergency referral)<br/>status = refused + trace"]
    IG -- "allowed (+ warnings, e.g. unsupported species)" --> PP

    subgraph AG["pawpal_ai/planner.py: AIPlanner.plan (agentic workflow, every step traced with the tool it called)"]
        PP["1. parse_profile<br/>keyword rules + ProfileClassifier.predict<br/>(species, life stage, conditions, minutes)"]
        MODEL[("models/profile_model.json<br/>Naive Bayes trained on<br/>data/profile_training.jsonl")] --> PP
        PP --> RET
        RET["2. KnowledgeRetriever.search<br/>TF-IDF cosine, top 3, species filter"]
        KB[("knowledge/*.md<br/>dogs, cats, general<br/>+ knowledge/custom/ (owner notes, vet notes)")] --> RET
        RET --> PR["3. propose tasks<br/>from TASK lines in retrieved chunks<br/>(built-in defaults if nothing retrieved)"]
        PR --> OG
        subgraph GR2["guardrails.py: validate_tasks (output guardrail)"]
            OG{"schema, bounds, no dosage text,<br/>dedupe, add missing feeding / water"}
        end
        OG --> REV["4. revise<br/>keep best-matching walk;<br/>drop tasks that conflict with a condition (e.g. fetch for joint pain);<br/>merge overlapping feeding tasks from different sources"]
        REV --> SCH
        subgraph CORE["pawpal_system.py: original PawPal+ core"]
            SCH["Scheduler.detect_conflicts,<br/>find_next_available_slot,<br/>generate_plan (sort, filter, lay out)"]
        end
        SCH --> SC{"5. self-check<br/>high-priority task missed?"}
        SC -- "yes (max 8 loops)" --> DROP["drop lowest-priority task,<br/>then collapse redundant meals"] --> SCH
        SC -- "no" --> CONF["6. confidence score<br/>(best retrieval score)"]
        CONF --> EXP["7. explain: constrained format<br/>quotes the best-matching retrieved sentence<br/>+ source citation"]
    end

    AG -. "unexpected exception" .-> ERR["safe error result<br/>status = error (no crash)"]
    EXP --> OUT["PlanResult: schedule, explanations,<br/>sources, confidence, warnings, trace"]
    OUT --> CONFIRM{"Owner reviews and confirms?<br/>(Streamlit button)"}
    CONFIRM -- "yes" --> PET["AIPlanner.apply_to_pet<br/>adds tasks to Pet / Owner"]
    OUT --> LOG["ai_interactions.md<br/>(demo.py --log traces)"]
    AG -. "every request" .-> LG["logs/pawpal.log"]

    EV["evals/run_evals.py (39 cases) + pytest (44 tests)<br/>guardrails, plan quality, consistency, specialization,<br/>classifier vs rules, RAG grounding, custom sources,<br/>agent chain, confidence, error handling"] -. "runs predefined inputs through plan()" .-> AG
    EV -. "results.md + results.json" .-> DEV(["Developer / reviewer"])
